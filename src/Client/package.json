{
  "name": "skystedt.se",
  "repository": "https://github.com/skystedt/skystedt.se",
  "author": "skystedt",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "yarn dedupe-browserslist-packages",
    "build": "webpack --config webpack.development.mjs",
    "production": "webpack --config webpack.production.mjs",
    "start": "webpack serve --config webpack.development.mjs --open",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc --project jsconfig.json --noEmit --pretty false | node -e \"const errors = require('fs').readFileSync(0).toString('utf-8').replace(/^node_modules.*\\r?\\n(?: .*\\r?\\n?)*/gm, '').trim(); if (errors) { console.log(errors); process.exit(1); }\"",
    "dedupe-browserslist-packages": "yarn dedupe caniuse-lite baseline-browser-mapping --strategy highest --mode=skip-build",
    "update-yarn": "corepack up",
    "ncu": "yarn dlx npm-check-updates",
    "update-transitive": "yarn dlx rimraf yarn.lock && yarn install",
    "eslint-inspector": "yarn dlx @eslint/config-inspector"
  },
  "engines": {
    "yarn": "4.x",
    "node": "24.x || 26.x"
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba",
